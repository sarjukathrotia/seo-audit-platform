# PageSpeed Insights API Key (Free from https://console.cloud.google.com/)
PAGESPEED_API_KEY=

# Anthropic Claude API Key (From https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Database URL (Defaults to SQLite in local dev)
DATABASE_URL="file:./dev.db"

# Optional Redis URL for BullMQ production queue
REDIS_URL="redis://localhost:6379"
